{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/flood_rainfall_forest_2003_2010.csv"
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#53645b",
      "titleColor": "#20372e",
      "gridColor": "#e7ece6",
      "domain": false,
      "tickColor": "#cdd7cf",
      "labelPadding": 7,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "orient": "bottom",
      "labelColor": "#53645b",
      "titleColor": "#20372e",
      "symbolStrokeWidth": 1
    }
  },
  "params": [
    {
      "name": "stateFocus",
      "value": "All states"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 2,
    "cornerRadius": 2
  },
  "encoding": {
    "x": {
      "field": "YEAR",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "flood_rate_percent",
        "op": "mean",
        "order": "descending"
      }
    },
    "color": {
      "field": "flood_rate_percent",
      "type": "quantitative",
      "title": "District records flooded (%)",
      "scale": {
        "domain": [
          0,
          100
        ],
        "range": [
          "#f0f5f8",
          "#246ba0"
        ]
      },
      "legend": {
        "gradientLength": 170
      }
    },
    "opacity": {
      "condition": {
        "test": "stateFocus === 'All states' || datum.state === stateFocus",
        "value": 1
      },
      "value": 0.23
    },
    "tooltip": [
      {
        "field": "state",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "YEAR",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "flood_rate_percent",
        "type": "quantitative",
        "title": "Recorded districts with flooding (%)",
        "format": ".1f"
      },
      {
        "field": "flood_records",
        "type": "quantitative",
        "title": "Flooded district records",
        "format": ".0f"
      },
      {
        "field": "district_records",
        "type": "quantitative",
        "title": "District records available",
        "format": ".0f"
      },
      {
        "field": "annual_rainfall_mean",
        "type": "quantitative",
        "title": "Mean annual rainfall (mm)",
        "format": ".1f"
      }
    ]
  }
}